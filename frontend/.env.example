# --- Local development -------------------------------------------------
# Browser calls the PHP API directly (CORS). Public — contains no secrets.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production (e.g. Vercel) -------------------------------------------
# Set BACKEND_URL instead: the browser calls same-origin /api/* and Next.js
# proxies to this URL, so the login cookie is first-party.
# BACKEND_URL=https://your-api.up.railway.app
