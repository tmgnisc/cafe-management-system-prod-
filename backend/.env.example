# ------------------------------------------------------------------
# Isha's Cozy Cafe — PHP API configuration
# Copy to backend/.env and adjust. Never commit the real .env file.
# ------------------------------------------------------------------
APP_ENV=development            # development | production
APP_DEBUG=true                 # false in production (hides internal error details)
APP_URL=http://localhost:8000  # public base URL of this API (used for uploaded image URLs)
APP_TIMEZONE=Asia/Kathmandu

# MySQL / MariaDB  (on Railway you can omit DB_* — MYSQLHOST/MYSQLPORT/MYSQLUSER/
# MYSQLPASSWORD/MYSQLDATABASE from the MySQL service are used automatically)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cafe
DB_USERNAME=root
DB_PASSWORD=
# DB_SOCKET=/opt/lampp/var/mysql/mysql.sock   # optional: connect via unix socket instead of TCP

# Comma-separated list of exact frontend origins allowed by CORS (credentials enabled)
FRONTEND_URL=http://localhost:3000

# Session cookie
SESSION_NAME=ISHACAFE_SESSION
SESSION_LIFETIME=720           # idle timeout in minutes
SESSION_SECURE_COOKIE=false    # MUST be true in production (HTTPS)
SESSION_SAMESITE=Lax           # Lax when frontend & API share a site; None (+Secure) for cross-site
SESSION_DOMAIN=
SESSION_DRIVER=database        # database (recommended) | files

# true when running behind a proxy (Railway, Vercel rewrites, nginx) so the
# real client IP is read from X-Forwarded-For (used for login throttling + audit)
TRUST_PROXY=false

# First SUPERADMIN, created by `php database/install.php` when there are no users.
# Required in production; in development they default to
# admin@ishascozycafe.com / IshaAdmin@2026.
ADMIN_NAME="Isha Sharma"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Login brute-force protection
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
